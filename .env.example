# Connection strings do Postgres (Supabase). Copie este arquivo para ".env"
# e preencha com a senha real do banco. Nunca commite o ".env" de verdade
# (já está no .gitignore).

# Pooler em modo transação — usado pela aplicação em tempo de execução.
DATABASE_URL="postgresql://postgres.bbseqazcdfmptmtaqrsn:SENHA@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler em modo sessão — usado só pelo Prisma CLI (migrations).
DIRECT_URL="postgresql://postgres.bbseqazcdfmptmtaqrsn:SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Envio de email (só "esqueci minha senha" por enquanto) via Resend
# (resend.com, tem plano gratuito). Sem essa chave, o link de recuperação
# não é enviado de verdade — a tela não quebra, só fica sem efeito.
RESEND_API_KEY="re_..."

# Opcional: remetente do email, no formato 'Nome <email@dominio>'. Só
# funciona com um domínio verificado no painel do Resend — sem isso, o
# sistema usa o remetente de testes deles (onboarding@resend.dev) sozinho.
# EMAIL_REMETENTE="Sistema Financeiro <financeiro@redejr.net>"

# Base do link de recuperação de senha nos emails enviados. Em produção na
# Vercel isso já é preenchido sozinho (VERCEL_URL); só precisa disso pra
# rodar localmente e ver o link certo no email de teste.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
